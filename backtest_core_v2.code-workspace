			"**/dist/**": true,
			"**/.mypy_cache": true,
			"docs/cahier de maintenance_sauvegarde": true
		},
		"search.exclude": {
			"AGEND_HISTORY.md": true,
			"**/backtest_results/**": true,
			"**/backtest_results_organized/**": true,
			"**/catalog/generated/**": true,
			"**/catalog/graduation_results/**": true,
			"**/docs/**": true,
			"**/examples/**": true,
			"**/labs/**": true,
			"**/output/**": true,
			"**/sandbox_strategies/**": true,
			"**/runs/**": true,
			"**/logs/**": true,
			"**/profiling_results/**": true,
			"**/sweep_diagnostics/**": true,
			"**/.llm_archive/**": true,
			"**/ui/components/archive/**": true,
			"**/.claude/**": true,
			"**/.tmp/**": true,
			"**/.tmp_*": true,
			"**/.indicator_cache/**": true,
			"**/.numba_cache/**": true,
			"**/.mypy_cache/**": true,
			"**/.venv/**": true,
			"**/node_modules/**": true,
			"**/*.parquet": true,
			"**/*.feather": true,
			"tests/**": true,
			"**/*.bak": true,
			"**/*.bak_*": true,
			"**/data/**": true,
			".coverage": true,
			"config/strategy_catalog.json": true,
			"analysis_report*.html": true,
			"analysis_top_configs.csv": true,
			"**/__pycache__": true,
			"**/*.pyc": true,
			"docs/cahier de maintenance_sauvegarde": true
		},
		"python.analysis.exclude": [
			".venv/**",
			"**/backtest_results/**",
			"**/backtest_results_organized/**",
			"**/catalog/generated/**",
			"**/catalog/graduation_results/**",
			"**/docs/**",
			"**/examples/**",
			"**/labs/**",
			"**/output/**",
			"**/sandbox_strategies/**",
			"**/ui/components/archive/**",
			"**/profiling_results/**",
			"**/sweep_diagnostics/**",
			"**/.claude/**",
			"**/.tmp/**",
			"**/.tmp_*",
			"**/runs/**",
			"**/logs/**",
			"**/__pycache__/**",
			"**/.indicator_cache/**",
			"**/.numba_cache/**",
			"**/.mypy_cache/**",
			"**/.pytest_cache/**",
			"**/.pytest_tmp/**",
			"**/.pytest_tmp_*/**",
			"**/.codex/**",
			"**/.llm_archive/**",
			"**/.venv/**",
			"**/data/**",
			"**/node_modules/**"
		],
		"github.copilot.chat.codebaseIndexing.exclusionGlobs": [
			"AGEND_HISTORY.md",
			".claude/**",
			".venv/**",
			"**/.mypy_cache/**",
			"**/.pytest_cache/**",
			"**/.pytest_tmp/**",
			"**/.pytest_tmp_*/**",
			"**/.tmp/**",
			"docs/**",
			"examples/**",
			"labs/**",
			"**/output/**",
			"**/profiling_results/**",
			"**/sweep_diagnostics/**",
			"**/data/**",
			"tests/**",
			".llm_archive/**",
			"catalog/generated/**",
			"catalog/graduation_results/**",
			"ui/components/archive/**",
			"config/strategy_catalog.json",
			"**/*.bak",
			"**/*.bak_*",
			"docs/cahier de maintenance_sauvegarde"
		],

		"python.defaultInterpreterPath": "d:/backtest_core_v2/.venv/Scripts/python.exe",
		"python.testing.pytestEnabled": true,
		"python.testing.pytestArgs": [
			"tests"
		],
		"python.envFile": "${workspaceFolder}\\.env",
		"editor.formatOnSave": false,
		"editor.rulers": [
			120
		],
		"python.analysis.typeCheckingMode": "basic",
		"python.analysis.diagnosticMode": "openFilesOnly",
		"python.analysis.diagnosticSeverityOverrides": {
			"reportMissingImports": "none",
			"reportMissingTypeStubs": "none",
			"reportUnusedImport": "warning",
			"reportUnusedVariable": "none",
			"reportGeneralTypeIssues": "none",
			"reportOptionalMemberAccess": "none",
			"reportPrivateUsage": "none",
			"reportArgumentType": "none",
			"reportReturnType": "none",
			"reportAssignmentType": "none",
			"reportUnnecessaryIsInstance": "none",
			"reportUnnecessaryCast": "none",
			"reportConstantRedefinition": "none",
			"reportIncompatibleMethodOverride": "none",
			"reportIncompatibleVariableOverride": "none",
			"reportInconsistentConstructor": "none",
			"reportUnusedExpression": "none",
			"reportUnusedCallResult": "none"
		},
		"python.analysis.extraPaths": [
			"."
		],
		"files.associations": {
			"*.toml": "toml",
			"*.yaml": "yaml",
			"*.yml": "yaml"
		},
		"explorer.compactFolders": false,
		"cSpell.language": "fr,en",
		"cSpell.ignorePaths": [
			"**/*.md"
		],
		"github.copilot.chat.claudeCode.debug": false,
		"chat.useAgentSkills": false,
		"powershell.cwd": "${workspaceFolder}",
		"claudeCode.initialPermissionMode": "bypassPermissions",
		"python.linting.enabled": false,
		"python.linting.pylintEnabled": false,
		"python.linting.flake8Enabled": false,
		"python.linting.mypyEnabled": false,
		"files.trimTrailingWhitespace": true,
		"markdownlint.enable": false,
		"[python]": {
			"editor.formatOnSave": false,
			"editor.defaultFormatter": "ms-python.black-formatter"
		},
		"[markdown]": {
			"editor.defaultFormatter": null,
			"editor.formatOnSave": false
		},
		"markdown.linters.markdownlint": {
			"config": {
				"MD003": false,
				"MD004": false,
				"MD012": false,
				"MD022": false,
				"MD025": false,
				"MD031": false,
				"MD032": false,
				"MD051": false,
				"MD060": false
			}
		},
		"codeQL.githubDatabase.download": "never",
		"git.autofetch": false,
		"git.autoRefresh": false,
		"terminal.integrated.maxRecent": 3,
		"workbench.editor.limit.enabled": true,
		"workbench.editor.limit.value": 8,
		"files.watcherExclude": {
			"**/backtest_results/**": true,
			"**/backtest_results_organized/**": true,
			"**/sandbox_strategies/**": true,
			"**/catalog/generated/**": true,
			"**/catalog/graduation_results/**": true,
			"**/docs/**": true,
			"**/examples/**": true,
			"**/labs/**": true,
			"**/output/**": true,
			"**/ui/components/archive/**": true,
			"**/.venv/**": true,
			"**/.git/objects/**": true,
			"**/.git/lfs/**": true,
			"**/.pytest_tmp/**": true,
			"**/.pytest_tmp_*/**": true,
			"**/.pytest_cache/**": true,
			"**/.mypy_cache/**": true,
			"**/.indicator_cache/**": true,
			"**/.numba_cache/**": true,
			"**/.codex/**": true,
			"**/.llm_archive/**": true,
			"**/.claude/**": true,
			"**/data/**": true,
			"**/runs/**": true,
			"**/logs/**": true,
			"**/profiling_results/**": true,
			"**/sweep_diagnostics/**": true,
			"**/.tmp/**": true,
			"**/.tmp_*": true,
			"**/__pycache__/**": true,
			"**/*.pyc": true,
			"AGEND_HISTORY.md": true,
			"config/strategy_catalog.json": true
		},
		"workbench.browser.enableChatTools": true
	},
	"extensions": {
		"recommendations": [
			"anthropic.claude-code",
			"github.copilot",
			"github.copilot-chat",
			"ms-python.python",
			"ms-python.vscode-pylance",
			"ms-python.black-formatter",
			"ms-toolsai.jupyter",
			"charliermarsh.ruff",
			"tamasfe.even-better-toml"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Streamlit UI (app.py - RECOMMANDE)",
				"type": "python",
				"request": "launch",
				"module": "streamlit",
				"args": [
					"run",
					"ui/app.py",
					"--server.headless=false"
				],
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${workspaceFolder}\\.env",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"CUDA_VISIBLE_DEVICES": "0,1"
				}
			},
			{
				"name": "Python: Test actuel",
				"type": "python",
				"request": "launch",
				"program": "${file}",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${workspaceFolder}\\.env",
				"env": {
					"PYTHONPATH": "${workspaceFolder}"
				}
			},
			{
				"name": "Python: Pytest (fichier actuel)",
				"type": "python",
				"request": "launch",
				"module": "pytest",
				"args": [
					"${file}",
					"-v",
					"-s"
				],
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${workspaceFolder}\\.env",
				"env": {
					"PYTHONPATH": "${workspaceFolder}"
				}
			}
		]
	}
}
