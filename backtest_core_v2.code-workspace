			"**/.tmp_*",
			"**/runs/**",
			"**/logs/**",
			"**/__pycache__/**",
			"**/.indicator_cache/**",
			"**/.numba_cache/**",
			"**/.mypy_cache/**",
			"**/.pytest_cache/**",
			"**/.pytest_tmp/**",
			"**/.codex/**",
			"**/.venv/**",
			"**/data/**",
			"**/node_modules/**"
		],
		"github.copilot.chat.codebaseIndexing.exclusionGlobs": [
			"AGEND_HISTORY.md",
			".claude/**",
			"docs/**",
			"examples/**",
			"labs/**",
			"catalog/generated/**",
			"catalog/graduation_results/**",
			"ui/components/archive/**",
			"config/strategy_catalog.json",
			"**/*.bak",
			"**/*.bak_*",
			"docs/cahier de maintenance_sauvegarde"
		],

		"python.defaultInterpreterPath": "d:/backtest_core_v2/.venv/Scripts/python.exe",
		"python.testing.pytestEnabled": true,
		"python.testing.pytestArgs": [
			"tests"
		],
		"python.envFile": "${workspaceFolder}\\.env",
		"editor.formatOnSave": false,
		"python.analysis.typeCheckingMode": "basic",
		"python.analysis.diagnosticMode": "openFilesOnly",
		"files.associations": {
			"*.toml": "toml",
			"*.yaml": "yaml",
			"*.yml": "yaml"
		},
		"explorer.compactFolders": false,
		"github.copilot.chat.claudeCode.debug": false,
		"chat.useAgentSkills": false,
		"powershell.cwd": "${workspaceFolder}",
		"claudeCode.initialPermissionMode": "bypassPermissions",
		"python.linting.pylintEnabled": false,
		"python.linting.flake8Enabled": false,
		"python.linting.mypyEnabled": false,
		"codeQL.githubDatabase.download": "never",
		"git.autofetch": false,
		"git.autoRefresh": false,
		"terminal.integrated.maxRecent": 3,
		"workbench.editor.limit.enabled": true,
		"workbench.editor.limit.value": 8,
		"files.watcherExclude": {
			"**/backtest_results/**": true,
			"**/backtest_results_organized/**": true,
			"**/sandbox_strategies/**": true,
			"**/catalog/**": true,
			"**/docs/**": true,
			"**/examples/**": true,
			"**/labs/**": true,
			"**/output/**": true,
			"**/ui/components/archive/**": true,
			"**/.venv/**": true,
			"**/.git/objects/**": true,
			"**/.git/lfs/**": true,
			"**/.pytest_tmp/**": true,
			"**/.pytest_cache/**": true,
			"**/.mypy_cache/**": true,
			"**/.indicator_cache/**": true,
			"**/.numba_cache/**": true,
			"**/.codex/**": true,
			"**/.claude/**": true,
			"**/data/**": true,
			"**/runs/**": true,
			"**/logs/**": true,
			"**/profiling_results/**": true,
			"**/sweep_diagnostics/**": true,
			"**/.tmp/**": true,
			"**/.tmp_*": true,
			"**/__pycache__/**": true,
			"**/*.pyc": true,
			"AGEND_HISTORY.md": true,
			"config/strategy_catalog.json": true
		},
		"workbench.browser.enableChatTools": true
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-python.vscode-pylance",
			"ms-toolsai.jupyter",
			"charliermarsh.ruff",
			"tamasfe.even-better-toml",
			"anthropic.claude-code"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Streamlit UI",
				"type": "debugpy",
				"request": "launch",
				"module": "streamlit",
				"args": [
					"run",
					"ui/app.py"
				],
				"console": "integratedTerminal"
			},
			{
				"name": "Run Backtest",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/run_grid_backtest.py",
				"console": "integratedTerminal"
			},
			{
				"name": "LLM Optimization",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/run_llm_optimization.py",
				"console": "integratedTerminal"
			},
			{
				"name": "Data Manager",
				"type": "debugpy",
				"request": "launch",
				"program": "D:/.my_soft/gestionnaire_telechargement_multi-timeframe_clean/crypto_data_manager.py",
				"console": "integratedTerminal"
			}
		]
	}
}
