			"**/data/**": true,
			".coverage": true,
			"config/strategy_catalog.json": true,
			"analysis_report*.html": true,
			"analysis_top_configs.csv": true,
			"**/__pycache__": true,
			"**/*.pyc": true,
			"docs/cahier de maintenance_sauvegarde": true
		},
		"python.analysis.exclude": [
			"**/backtest_results/**",
			"**/backtest_results_organized/**",
			"**/catalog/generated/**",
			"**/catalog/graduation_results/**",
			"**/docs/**",
