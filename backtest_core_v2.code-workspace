{
	"folders": [
		{
			"path": ".",
			"name": "backtest_core_v2"
		},
		{
			"path": "K:\\models",
			"name": "models_data",
			"hidden": true
		}
	],
	"settings": {
		"files.exclude": {
			"**/.tmp/**": true,
			"**/.tmp_*": true,
			"**/.cache/**": true,
			"**/.numba_cache/**": true,
			"**/.ruff_cache/**": true,
			"**/.pytest_cache/**": true,
			"**/.pytest_tmp_local/**": true,
			"**/pytest_temp/**": true,
			"**/sweep_diagnostics/**": true,
			"**/profiling_results/**": true,
			"**/backtest_results/**": true,
			"**/backtest_results_organized/**": true,
			"**/sandbox_strategies/**": true,
			"**/__pycache__": true,
			"**/*.pyc": true,
			"**/*.pyo": true,
			"**/*.egg-info": true,
			"**/.mypy_cache": true
		},
		"search.exclude": {
			"**/backtest_results/**": true,
			"**/backtest_results_organized/**": true,
			"**/sandbox_strategies/**": true,
			"**/runs/**": true,
			"**/logs/**": true,
			"**/profiling_results/**": true,
			"**/sweep_diagnostics/**": true,
			"**/.tmp/**": true,
			"**/.tmp_*": true,
			"**/__pycache__": true,
			"**/*.pyc": true
		},
		"python.analysis.exclude": [
			"**/backtest_results/**",
			"**/backtest_results_organized/**",
			"**/sandbox_strategies/**",
			"**/profiling_results/**",
			"**/sweep_diagnostics/**",
			"**/.tmp/**",
			"**/.tmp_*",
			"**/runs/**",
			"**/logs/**",
			"**/__pycache__/**"
		],
		"files.watcherExclude": {
			"**/backtest_results/**": true,
			"**/backtest_results_organized/**": true,
			"**/sandbox_strategies/**": true,
			"**/runs/**": true,
			"**/logs/**": true,
			"**/profiling_results/**": true,
			"**/sweep_diagnostics/**": true,
			"**/.tmp/**": true,
			"**/.tmp_*": true,
			"**/__pycache__/**": true
		},
		"python.defaultInterpreterPath": "d:/backtest_core_v2/.venv/Scripts/python.exe",
		"python.testing.pytestEnabled": true,
		"python.testing.pytestArgs": [
			"tests"
		],
		"python.envFile": "${workspaceFolder}\\.env",
		"editor.formatOnSave": false,
		"python.analysis.typeCheckingMode": "basic",
		"python.analysis.diagnosticMode": "openFilesOnly",
		"files.associations": {
			"*.toml": "toml",
			"*.yaml": "yaml",
			"*.yml": "yaml"
		},
		"github.copilot.chat.claudeCode.debug": true,
		"chat.useAgentSkills": true,
		"powershell.cwd": "${workspaceFolder}",
		"claudeCode.initialPermissionMode": "bypassPermissions",
		"python.linting.pylintEnabled": false,
		"python.linting.flake8Enabled": false,
		"python.linting.mypyEnabled": false,
		"codeQL.githubDatabase.download": "never"
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-python.vscode-pylance",
			"ms-toolsai.jupyter",
			"charliermarsh.ruff",
			"tamasfe.even-better-toml",
			"anthropic.claude-code"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Streamlit UI",
				"type": "debugpy",
				"request": "launch",
				"module": "streamlit",
				"args": [
					"run",
					"ui/app.py"
				],
				"console": "integratedTerminal"
			},
			{
				"name": "Run Backtest",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/run_grid_backtest.py",
				"console": "integratedTerminal"
			},
			{
				"name": "LLM Optimization",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/run_llm_optimization.py",
				"console": "integratedTerminal"
			},
			{
				"name": "Data Manager",
				"type": "debugpy",
				"request": "launch",
				"program": "D:/.my_soft/gestionnaire_telechargement_multi-timeframe_clean/crypto_data_manager.py",
				"console": "integratedTerminal"
			}
		]
	}
}
